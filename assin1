
from collections import deque

def bfs(start, goal):
    q = deque([(start, [])])
    visited = {tuple(map(tuple, start))}
    n = len(start)

    while q:
        grid, path = q.popleft()

        if grid == goal:
            return path + [grid]

        x = y = 0
        for i in range(n):
            for j in range(n):
                if grid[i][j] == 0:
                    x, y = i, j

        for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:
            nx, ny = x + dx, y + dy

            if 0 <= nx < n and 0 <= ny < n:
                new_grid = [row[:] for row in grid]
                new_grid[x][y], new_grid[nx][ny] = (
                    new_grid[nx][ny], new_grid[x][y]
                )

                state = tuple(map(tuple, new_grid))

                if state not in visited:
                    visited.add(state)
                    q.append((new_grid, path + [grid]))

    return None


start = [
    [1, 2, 3],
    [4, 0, 6],
    [7, 5, 8]
]

goal = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 0]
]

result = bfs(start, goal)

if result:
    print("Solution found in", len(result) - 1, "moves:")
    for grid in result:
        for row in grid:
            print(row)
        print()
else:
    print("No solution found")
